COMPOSE_PROJECT_NAME=ddna-rebuild

MARIADB_VERSION=11.4.12
DB_NAME=ddna_wordpress
DB_USER=ddna_wp
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-root-password

WORDPRESS_VERSION=7.0.2-php8.3-apache
WP_CLI_VERSION=cli-php8.3
WP_PORT=8080
WP_URL=http://localhost:8080
WP_TABLE_PREFIX=wp_
WP_ENVIRONMENT_TYPE=local
WP_DEBUG=0
WP_DEBUG_LOG=0
WP_FORCE_HTTPS=0
WP_DISABLE_CRON=0
WP_SITE_TITLE=DDNA Cordoba - Desarrollo
WP_ADMIN_USER=ddna_admin
WP_ADMIN_PASSWORD=change-admin-password
WP_ADMIN_EMAIL=admin@example.test
